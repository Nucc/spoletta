FROM docker.io/library/golang:1.25-alpine AS build

WORKDIR /src
COPY worker/go.mod ./
COPY worker/*.go ./
RUN CGO_ENABLED=0 go build -o /out/worker .

# pi is an npm package, so the worker runs on a Node image.
FROM docker.io/library/node:22-alpine

# git and bash give the agent's tools something to work with, and scripts
# get curl and jq to call APIs. su-exec drops root as the worker starts.
RUN apk add --no-cache bash curl git jq su-exec
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.0.4

COPY --from=build /out/worker /usr/local/bin/worker
COPY worker/submit-output.ts /opt/flow/submit-output.ts
COPY worker/mcp-servers.ts /opt/flow/mcp-servers.ts
COPY --chmod=755 worker/git-credential.sh /opt/flow/git-credential.sh
# The guide to authoring flows, which flows' assistants read.
COPY docs/FLOWS.md /opt/flow/docs/FLOWS.md
# Agents commit to their run's branch as this, unless GIT_AUTHOR_NAME and
# the like say otherwise. No credential helper is configured: each step's
# environment names git-credential.sh with the step's own token.
RUN git config --system user.name "Flow agent" \
 && git config --system user.email "flow-agent@localhost"

# Everything runs as flow, uid 1000, in place of the image's node user;
# see entrypoint.sh. The volumes are flow's when made from the image;
# what the image puts in /opt/flow stays root's, so no step can change
# the extensions the next one runs.
RUN deluser --remove-home node \
 && adduser -D -u 1000 -h /home/flow flow \
 && mkdir -p /data/files /data/workspaces \
 && chown -R flow:flow /data /home/flow
COPY --chmod=755 worker/entrypoint.sh /opt/flow/entrypoint.sh

EXPOSE 8090
ENTRYPOINT ["/opt/flow/entrypoint.sh"]
CMD ["worker"]
