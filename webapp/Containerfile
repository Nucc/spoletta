# The bases name their patch releases, so a base cached from before a
# security release can't stand in for the one patched.
FROM docker.io/library/node:22.23.4-alpine AS frontend

WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM docker.io/library/golang:1.27.3-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# SETUP.md goes into the assistant's prompt.
COPY *.go SETUP.md ./
# The migrations are embedded in the binary.
COPY migrations ./migrations
# The ready flows are embedded too.
COPY templates ./templates
RUN CGO_ENABLED=0 go build -o /out/webapp .

FROM docker.io/library/alpine:3.24

COPY --from=build /out/webapp /usr/local/bin/webapp
COPY --from=frontend /src/dist /srv/static
ENV STATIC_DIR=/srv/static
EXPOSE 8080
CMD ["webapp"]
